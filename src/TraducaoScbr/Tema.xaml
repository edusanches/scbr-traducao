<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    As cores do design system "Star Citizen Brasil" (src/app/globals.css do site): espaço profundo, só tema escuro.
    As transparências do site viram cores ARGB.
  -->
  <Color x:Key="CorSuperficie">#FF060912</Color>
  <Color x:Key="CorSuperficieElevada">#FF0B1020</Color>
  <Color x:Key="CorSuperficieFunda">#FF04060D</Color>
  <Color x:Key="CorVidro">#09FFFFFF</Color>
  <Color x:Key="CorVidroForte">#12FFFFFF</Color>
  <Color x:Key="CorLinha">#2494A3B8</Color>
  <Color x:Key="CorLinhaForte">#5794A3B8</Color>
  <Color x:Key="CorTinta">#FFEDF2FB</Color>
  <Color x:Key="CorTintaSuave">#FF97A2B6</Color>
  <Color x:Key="CorAcento">#FF5AABF6</Color>
  <Color x:Key="CorAcentoHover">#FF8FC8FA</Color>
  <Color x:Key="CorSobreAcento">#FF03111F</Color>
  <Color x:Key="CorAcentoSuave">#245AABF6</Color>
  <Color x:Key="CorSobreAcentoSuave">#FFB9DCFC</Color>
  <Color x:Key="CorPositivo">#FF22C96B</Color>
  <Color x:Key="CorPositivoSuave">#2122C96B</Color>
  <Color x:Key="CorSobrePositivoSuave">#FF93EFBA</Color>
  <Color x:Key="CorAviso">#FFF0B45A</Color>
  <Color x:Key="CorAvisoSuave">#1FF0B45A</Color>
  <Color x:Key="CorPerigo">#FFF2877E</Color>
  <Color x:Key="CorPerigoSuave">#1FF2877E</Color>
  <Color x:Key="CorFoco">#FF86B4FF</Color>
  <Color x:Key="CorBarra">#FF0A1835</Color>

  <SolidColorBrush x:Key="Superficie" Color="{StaticResource CorSuperficie}" />
  <SolidColorBrush x:Key="SuperficieElevada" Color="{StaticResource CorSuperficieElevada}" />
  <SolidColorBrush x:Key="SuperficieFunda" Color="{StaticResource CorSuperficieFunda}" />
  <SolidColorBrush x:Key="Vidro" Color="{StaticResource CorVidro}" />
  <SolidColorBrush x:Key="VidroForte" Color="{StaticResource CorVidroForte}" />
  <SolidColorBrush x:Key="Linha" Color="{StaticResource CorLinha}" />
  <SolidColorBrush x:Key="LinhaForte" Color="{StaticResource CorLinhaForte}" />
  <SolidColorBrush x:Key="Tinta" Color="{StaticResource CorTinta}" />
  <SolidColorBrush x:Key="TintaSuave" Color="{StaticResource CorTintaSuave}" />
  <SolidColorBrush x:Key="Acento" Color="{StaticResource CorAcento}" />
  <SolidColorBrush x:Key="AcentoHover" Color="{StaticResource CorAcentoHover}" />
  <SolidColorBrush x:Key="SobreAcento" Color="{StaticResource CorSobreAcento}" />
  <SolidColorBrush x:Key="AcentoSuave" Color="{StaticResource CorAcentoSuave}" />
  <SolidColorBrush x:Key="SobreAcentoSuave" Color="{StaticResource CorSobreAcentoSuave}" />
  <SolidColorBrush x:Key="Positivo" Color="{StaticResource CorPositivo}" />
  <SolidColorBrush x:Key="PositivoSuave" Color="{StaticResource CorPositivoSuave}" />
  <SolidColorBrush x:Key="SobrePositivoSuave" Color="{StaticResource CorSobrePositivoSuave}" />
  <SolidColorBrush x:Key="Aviso" Color="{StaticResource CorAviso}" />
  <SolidColorBrush x:Key="AvisoSuave" Color="{StaticResource CorAvisoSuave}" />
  <SolidColorBrush x:Key="Perigo" Color="{StaticResource CorPerigo}" />
  <SolidColorBrush x:Key="PerigoSuave" Color="{StaticResource CorPerigoSuave}" />
  <SolidColorBrush x:Key="Foco" Color="{StaticResource CorFoco}" />
  <SolidColorBrush x:Key="Barra" Color="{StaticResource CorBarra}" />

  <!-- O fundo com o brilho de nebulosa do site (glow-blue e glow-green). -->
  <RadialGradientBrush x:Key="FundoJanela" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.9" RadiusY="0.6">
    <GradientStop Color="#264F8CFF" Offset="0" />
    <GradientStop Color="#00060912" Offset="1" />
  </RadialGradientBrush>

  <FontFamily x:Key="Fonte">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FonteTitulo">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FonteMono">Cascadia Mono, Consolas</FontFamily>

  <!-- O anel de foco do teclado, na cor de foco do site. -->
  <Style x:Key="AnelDeFoco">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" BorderBrush="{StaticResource Foco}" BorderThickness="2" CornerRadius="9" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botões: o principal no azul claro dos botões da RSI, o secundário em vidro e o de link. -->
  <Style x:Key="BotaoBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Fonte}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource AnelDeFoco}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fundo" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
    <Setter Property="Background" Value="{StaticResource Acento}" />
    <Setter Property="Foreground" Value="{StaticResource SobreAcento}" />
    <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
    <Setter Property="BorderThickness" Value="1" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AcentoHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource AcentoHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Acento}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
    <Setter Property="Background" Value="{StaticResource VidroForte}" />
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
    <Setter Property="BorderBrush" Value="{StaticResource LinhaForte}" />
    <Setter Property="BorderThickness" Value="1" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AcentoSuave}" />
        <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BotaoLink" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Acento}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="FontWeight" Value="Normal" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource AcentoHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Os blocos da tela (como os Panel do site). -->
  <Style x:Key="Painel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuperficieElevada}" />
    <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <Style x:Key="Rotulo" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fonte}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TintaSuave}" />
  </Style>

  <Style x:Key="Texto" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fonte}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="TextoSuave" TargetType="TextBlock" BasedOn="{StaticResource Texto}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TintaSuave}" />
  </Style>

  <!-- A etiqueta do canal (LIVE, PTU...), como as Tag do site. -->
  <Style x:Key="Etiqueta" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AcentoSuave}" />
    <Setter Property="BorderBrush" Value="#405AABF6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A caixa de seleção no azul da SCBR (a do tema Fluent segue a cor de destaque do Windows). -->
  <Style x:Key="Caixa" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource Fonte}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Quadro" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0"
                    BorderBrush="{StaticResource LinhaForte}" Background="{StaticResource Vidro}">
              <Path x:Name="Marca" Data="M3.5,8.5 L7,12 L13,5" Stroke="{StaticResource SobreAcento}" StrokeThickness="2.2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Quadro" Property="BorderBrush" Value="{StaticResource Acento}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Quadro" Property="Background" Value="{StaticResource Acento}" />
              <Setter TargetName="Quadro" Property="BorderBrush" Value="{StaticResource Acento}" />
              <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Quadro" Property="BorderBrush" Value="{StaticResource Foco}" />
              <Setter TargetName="Quadro" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- O símbolo da Star Citizen Brasil em vetor (src/components/ui/symbol.tsx do site). -->
  <DrawingImage x:Key="Simbolo">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#009C3B">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="3,3,42,42" RadiusX="9" RadiusY="9" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFD43B" Geometry="M24,9.5 L43,24 L24,38.5 L5,24 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFD43B" Thickness="1.2" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="White" Thickness="2" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="24,24" RadiusX="17.5" RadiusY="5">
              <EllipseGeometry.Transform>
                <RotateTransform Angle="-16" CenterX="24" CenterY="24" />
              </EllipseGeometry.Transform>
            </EllipseGeometry>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#2B5FD6">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="24,24" RadiusX="9" RadiusY="9" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#4F8CFF" Geometry="M29.285,16.715 A9,9 0 0 0 16.715,29.285 A9,9 0 0 0 29.285,16.715 Z" />
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="White" Thickness="2" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M6.5,24 A17.5,5 0 0 0 41.5,24">
              <PathGeometry.Transform>
                <RotateTransform Angle="-16" CenterX="24" CenterY="24" />
              </PathGeometry.Transform>
            </PathGeometry>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

</ResourceDictionary>
